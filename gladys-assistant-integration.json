{
  "manifest_version": 1,
  "type": "device",
  "name": "evcc",
  "description": {
    "en": "Solar EV charging with evcc: energy flow, loadpoints, vehicles, modes and limits.",
    "fr": "Recharge solaire avec evcc : flux d'énergie, points de charge, véhicules, modes et limites.",
    "de": "Solarladen mit evcc: Energiefluss, Ladepunkte, Fahrzeuge, Modi und Limits.",
    "es": "Carga solar con evcc: flujo de energía, puntos de carga, vehículos, modos y límites."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-evcc:1.0.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-evcc/main/cover.png",
  "categories": ["energy"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Connect your evcc",
        "fr": "Connecter votre evcc",
        "de": "Verbinde dein evcc",
        "es": "Conecte su evcc"
      },
      "description": {
        "en": "Enter the address of evcc as you open it in your browser (port 7070 by default). The integration follows evcc live through its websocket. The admin password is only needed if your evcc asks for it to change a mode or a limit.",
        "fr": "Saisissez l'adresse d'evcc telle que vous l'ouvrez dans votre navigateur (port 7070 par défaut). L'intégration suit evcc en direct par son websocket. Le mot de passe administrateur n'est utile que si votre evcc le demande pour changer un mode ou une limite.",
        "de": "Gib die Adresse von evcc ein, wie du sie im Browser öffnest (standardmäßig Port 7070). Die Integration folgt evcc live über seinen Websocket. Das Admin-Passwort brauchst du nur, wenn dein evcc es zum Ändern eines Modus oder Limits verlangt.",
        "es": "Introduzca la dirección de evcc tal como la abre en su navegador (puerto 7070 por defecto). La integración sigue evcc en directo por su websocket. La contraseña de administrador solo hace falta si su evcc la pide para cambiar un modo o un límite."
      },
      "links": [
        {
          "url": "https://docs.evcc.io/en/docs/reference/api",
          "label": {
            "en": "evcc API",
            "fr": "API d'evcc",
            "de": "evcc-API",
            "es": "API de evcc"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "evcc address",
        "fr": "Adresse d'evcc",
        "de": "Adresse von evcc",
        "es": "Dirección de evcc"
      },
      "placeholder": {
        "en": "e.g. http://192.168.1.20:7070",
        "fr": "ex. http://192.168.1.20:7070",
        "de": "z. B. http://192.168.1.20:7070",
        "es": "p. ej. http://192.168.1.20:7070"
      },
      "description": {
        "en": "Without a port, 7070 is used. A path is allowed behind a reverse proxy.",
        "fr": "Sans port, 7070 est utilisé. Un chemin est accepté derrière un proxy inverse.",
        "de": "Ohne Port wird 7070 verwendet. Hinter einem Reverse-Proxy ist ein Pfad erlaubt.",
        "es": "Sin puerto, se usa el 7070. Se admite una ruta detrás de un proxy inverso."
      },
      "required": true,
      "default": ""
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Admin password (optional)",
        "fr": "Mot de passe administrateur (facultatif)",
        "de": "Admin-Passwort (optional)",
        "es": "Contraseña de administrador (opcional)"
      },
      "description": {
        "en": "Recent evcc versions change modes and limits without it.",
        "fr": "Les versions récentes d'evcc changent modes et limites sans lui.",
        "de": "Neuere evcc-Versionen ändern Modi und Limits ohne Passwort.",
        "es": "Las versiones recientes de evcc cambian modos y límites sin ella."
      },
      "required": false
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
        "fr": "Langue des noms de fonctionnalités",
        "de": "Sprache der Funktionsnamen",
        "es": "Idioma de los nombres de funciones"
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": { "en": "English", "fr": "Anglais", "de": "Englisch", "es": "Inglés" }
        },
        {
          "value": "fr",
          "label": { "en": "French", "fr": "Français", "de": "Französisch", "es": "Francés" }
        },
        {
          "value": "de",
          "label": { "en": "German", "fr": "Allemand", "de": "Deutsch", "es": "Alemán" }
        },
        {
          "value": "es",
          "label": { "en": "Spanish", "fr": "Espagnol", "de": "Spanisch", "es": "Español" }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 20
    }
  ],
  "scene_triggers": [
    {
      "key": "vehicle_connected",
      "label": {
        "en": "Vehicle plugged in",
        "fr": "Véhicule branché",
        "de": "Fahrzeug angesteckt",
        "es": "Vehículo conectado"
      },
      "description": {
        "en": "A vehicle is plugged into a loadpoint (once evcc identified it, 2 min at most).",
        "fr": "Un véhicule est branché sur un point de charge (une fois identifié par evcc, 2 min au plus).",
        "de": "Ein Fahrzeug wird an einem Ladepunkt angesteckt (sobald evcc es erkennt, höchstens 2 Min.).",
        "es": "Un vehículo se conecta a un punto de carga (una vez identificado por evcc, 2 min como máximo)."
      },
      "fields": [
